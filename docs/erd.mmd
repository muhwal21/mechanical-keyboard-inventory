erDiagram
  USERS ||--o{ STOCK_MOVEMENTS : "mencatat (user_id)"
  PRODUCTS ||--o{ STOCK_MOVEMENTS : "berubah lewat (product_id)"
  CATEGORIES ||--o{ PRODUCTS : "mengelompokkan (category_id)"
  SUPPLIERS |o--o{ PRODUCTS : "memasok (supplier_id, nullable)"

  USERS {
    int id PK
    varchar name
    varchar email UK
    varchar password_hash "bcrypt"
    enum role "admin | staff"
    boolean is_active
    datetime created_at
    datetime updated_at
  }
  CATEGORIES {
    int id PK
    varchar slug UK
    varchar name UK
  }
  SUPPLIERS {
    int id PK
    varchar name UK
    varchar contact_person
    varchar phone
    varchar email
    varchar city
    varchar website
    varchar notes
    boolean is_active
    datetime created_at
    datetime updated_at
  }
  PRODUCTS {
    int id PK
    int category_id FK "ON DELETE RESTRICT"
    int supplier_id FK "ON DELETE SET NULL"
    varchar sku UK
    varchar name
    varchar brand
    text description
    decimal price_min "referensi listing"
    decimal price_max "referensi listing"
    decimal purchase_price
    decimal selling_price
    char currency "IDR | USD"
    varchar listing_status
    int warehouse_stock
    int reorder_point
    varchar storage_location
    varchar source_url
    varchar image_url
    json specifications
    json variants
    boolean is_active "soft delete / arsip"
    datetime created_at
    datetime updated_at
  }
  STOCK_MOVEMENTS {
    bigint id PK
    int product_id FK "ON DELETE RESTRICT"
    int user_id FK "ON DELETE RESTRICT"
    enum movement_type "IN | OUT | ADJUSTMENT"
    int quantity
    int stock_before
    int stock_after
    varchar note
    datetime created_at
  }
