NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=keystock.sid

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keyboard_inventory
DB_USER=keyboard_inventory_app
DB_PASSWORD=replace-with-a-local-password
DB_ROOT_PASSWORD=replace-with-a-local-root-password

# Demo accounts created by `npm run db:seed` (password minimal 8 karakter).
# Login bisa memakai username ATAU email.
SEED_ADMIN_NAME=KeyStock Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@keystock.local
SEED_ADMIN_PASSWORD=replace-with-a-demo-password
# Akun uji untuk dosen (peran admin) dan staff (peran staff).
SEED_DOSEN_NAME=Dosen Penguji
SEED_DOSEN_USERNAME=dosen
SEED_DOSEN_EMAIL=dosen@keystock.local
SEED_DOSEN_PASSWORD=12345678
SEED_STAFF_NAME=Staff Gudang
SEED_STAFF_USERNAME=staff
SEED_STAFF_EMAIL=staff@keystock.local
SEED_STAFF_PASSWORD=12345678

# Production (Railway): DB_* may be left empty when the MySQL service variables
# MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD are referenced instead.
